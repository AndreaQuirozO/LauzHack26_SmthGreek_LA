# API key for Together.AI (required for AI features)
TOGETHER_API_KEY=your-together-api-key

# Optional: Override the default model (defaults to moonshotai/Kimi-K3.1-Pro)
# TOGETHER_MODEL=

# Optional: Override the default Together.AI base URL
# TOGETHER_BASE_URL=https://api.together.xyz/v1

# Alternative: Use an OpenAI-compatible provider instead of Together.AI
# OPENAI_API_KEY=your-model-provider-key
# OPENAI_MODEL=your-model-name
# OPENAI_BASE_URL=https://api.openai.com/v1

# Demo administrator secret for approving updates
# DEMO_ADMIN_SECRET=choose-a-long-local-demo-secret
